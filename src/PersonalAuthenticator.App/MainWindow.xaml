<Window
    x:Class="PersonalAuthenticator.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:PersonalAuthenticator.App.Converters"
    xmlns:viewModels="using:PersonalAuthenticator.App.ViewModels"
    Title="Personal Authenticator">

  <Grid
      x:Name="Root"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid.Resources>
      <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
      <converters:BooleanToVisibilityConverter x:Key="InverseBooleanToVisibility" Invert="True" />
      <Style x:Key="StretchListViewItemStyle" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
      </Style>
    </Grid.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid
        x:Name="AppTitleBar"
        Grid.Row="0"
        Height="48"
        Padding="16,0,140,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Image
          Width="24"
          Height="24"
          VerticalAlignment="Center"
          AutomationProperties.Name="Personal Authenticator"
          Source="Assets/PersonalAuthenticator.png" />
      <TextBlock
          Grid.Column="1"
          Margin="10,0,0,0"
          VerticalAlignment="Center"
          FontSize="13"
          FontWeight="SemiBold"
          Text="Personal Authenticator" />
    </Grid>

    <InfoBar
        x:Name="NotificationBar"
        Grid.Row="1"
        Margin="24,8,24,0"
        IsClosable="True"
        IsOpen="False" />

    <Grid Grid.Row="2" Padding="24,16,24,24">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <AutoSuggestBox
            x:Name="SearchBox"
            Width="360"
            MaxWidth="520"
            HorizontalAlignment="Left"
            AutomationProperties.Name="Search authenticator accounts"
            PlaceholderText="Search accounts"
            QueryIcon="Find"
            TextChanged="SearchBox_TextChanged" />
        <ToggleButton
            Grid.Column="1"
            Margin="8,0,0,0"
            AutomationProperties.Name="Show favourite accounts only"
            Click="FavouritesButton_Click">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <FontIcon FontSize="14" Glyph="&#xE735;" />
            <TextBlock Text="Favourites" />
          </StackPanel>
        </ToggleButton>
        <Button
            x:Name="AddAccountButton"
            Grid.Column="2"
            Margin="8,0,0,0"
            AutomationProperties.Name="Add authenticator account"
            Click="AddAccountButton_Click"
            Style="{StaticResource AccentButtonStyle}">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <FontIcon FontSize="14" Glyph="&#xE710;" />
            <TextBlock Text="Add account" />
          </StackPanel>
        </Button>
        <Button
            Grid.Column="3"
            Margin="8,0,0,0"
            AutomationProperties.Name="{Binding LockButtonLabel, Mode=OneWay}"
            Click="LockButton_Click"
            ToolTipService.ToolTip="{Binding LockButtonLabel, Mode=OneWay}">
          <FontIcon Glyph="&#xE72E;" />
        </Button>
        <Button
            Grid.Column="4"
            Margin="8,0,0,0"
            AutomationProperties.Name="Open settings"
            Click="SettingsButton_Click"
            ToolTipService.ToolTip="Settings">
          <FontIcon Glyph="&#xE713;" />
        </Button>
      </Grid>

      <Grid Grid.Row="1">
        <Grid
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{Binding IsLocked, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}">
          <StackPanel MaxWidth="440" HorizontalAlignment="Center" Spacing="14">
            <FontIcon
                HorizontalAlignment="Center"
                FontSize="54"
                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                Glyph="&#xE72E;" />
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="28"
                FontWeight="SemiBold"
                Text="Your vault is locked" />
            <TextBlock
                HorizontalAlignment="Center"
                Text="Unlock to decrypt your accounts and generate one-time codes."
                TextAlignment="Center"
                TextWrapping="Wrap"
                Style="{StaticResource BodyTextBlockStyle}" />
            <Button
                HorizontalAlignment="Center"
                AutomationProperties.Name="Unlock vault"
                Click="UnlockButton_Click"
                Content="Unlock vault"
                Style="{StaticResource AccentButtonStyle}" />
          </StackPanel>
        </Grid>

        <Grid Visibility="{Binding IsUnlocked, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}">
          <Grid
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Visibility="{Binding HasAccounts, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibility}}">
            <StackPanel MaxWidth="480" HorizontalAlignment="Center" Spacing="12">
              <FontIcon
                  HorizontalAlignment="Center"
                  FontSize="48"
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                  Glyph="&#xE8D7;" />
              <TextBlock
                  HorizontalAlignment="Center"
                  FontSize="24"
                  FontWeight="SemiBold"
                  Text="No matching accounts" />
              <TextBlock
                  HorizontalAlignment="Center"
                  Text="Add a setup URI, QR image, or manual TOTP account. Everything stays on this PC."
                  TextAlignment="Center"
                  TextWrapping="Wrap" />
              <Button
                  HorizontalAlignment="Center"
                  Click="AddAccountButton_Click"
                  Content="Add your first account"
                  Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
          </Grid>

          <ListView
              x:Name="AccountList"
              AutomationProperties.Name="Authenticator accounts"
              IsItemClickEnabled="True"
              ItemContainerStyle="{StaticResource StretchListViewItemStyle}"
              ItemsSource="{Binding VisibleAccounts, Mode=OneWay}"
              SelectionMode="None">
            <ListView.ItemsPanel>
              <ItemsPanelTemplate>
                <ItemsStackPanel Orientation="Vertical" />
              </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="viewModels:AccountCardViewModel">
                <Border Style="{StaticResource CardStyle}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock
                            FontSize="18"
                            FontWeight="SemiBold"
                            Text="{x:Bind Issuer, Mode=OneWay}" />
                        <FontIcon
                            AutomationProperties.Name="Favourite account"
                            FontSize="13"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Glyph="{x:Bind FavouriteGlyph, Mode=OneWay}"
                            Visibility="{Binding Favourite, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}" />
                      </StackPanel>
                      <TextBlock
                          Margin="0,4,0,0"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          Text="{x:Bind AccountName, Mode=OneWay}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                      <Button
                          AutomationProperties.Name="Reveal or hide code"
                          Click="RevealButton_Click"
                          Tag="{x:Bind}"
                          ToolTipService.ToolTip="Reveal or hide code">
                        <FontIcon Glyph="&#xE890;" />
                      </Button>
                      <Button
                          AutomationProperties.Name="Copy current code"
                          Click="CopyButton_Click"
                          Tag="{x:Bind}"
                          ToolTipService.ToolTip="Copy code">
                        <FontIcon Glyph="&#xE8C8;" />
                      </Button>
                      <Button
                          AutomationProperties.Name="Account actions"
                          ToolTipService.ToolTip="More actions">
                        <FontIcon Glyph="&#xE712;" />
                        <Button.Flyout>
                          <MenuFlyout>
                            <MenuFlyoutItem
                                Click="EditMenuItem_Click"
                                Icon="Edit"
                                Tag="{x:Bind}"
                                Text="Edit display information" />
                            <MenuFlyoutItem
                                Click="FavouriteMenuItem_Click"
                                Icon="Favorite"
                                Tag="{x:Bind}"
                                Text="Favourite or unfavourite" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Click="MoveUpMenuItem_Click" Tag="{x:Bind}" Text="Move up" />
                            <MenuFlyoutItem Click="MoveDownMenuItem_Click" Tag="{x:Bind}" Text="Move down" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem
                                Click="DeleteMenuItem_Click"
                                Icon="Delete"
                                Tag="{x:Bind}"
                                Text="Delete" />
                          </MenuFlyout>
                        </Button.Flyout>
                      </Button>
                    </StackPanel>

                    <TextBlock
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Margin="0,20,0,14"
                        AutomationProperties.Name="Current one-time code"
                        FontFamily="Consolas"
                        FontSize="36"
                        FontWeight="SemiBold"
                        IsTextSelectionEnabled="False"
                        Text="{x:Bind DisplayCode, Mode=OneWay}" />

                    <Grid Grid.Row="2" Grid.ColumnSpan="2">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <ProgressBar
                          Height="4"
                          VerticalAlignment="Center"
                          AutomationProperties.Name="{x:Bind AccessibleCountdown, Mode=OneWay}"
                          IsIndeterminate="False"
                          Maximum="{x:Bind Period}"
                          Value="{x:Bind CountdownValue, Mode=OneWay}" />
                      <TextBlock
                          Grid.Column="1"
                          Margin="14,0,0,0"
                          VerticalAlignment="Center"
                          AutomationProperties.Name="{x:Bind AccessibleCountdown, Mode=OneWay}"
                          Text="{x:Bind SecondsRemaining, Mode=OneWay}" />
                    </Grid>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</Window>
