<ContentDialog
    x:Class="PersonalAuthenticator.App.Dialogs.AddAccountDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Add an authenticator account"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="Dialog_PrimaryButtonClick"
    PrimaryButtonText="Preview">

  <Grid Width="620" MinHeight="430">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TabView x:Name="ImportTabs" Grid.Row="0" IsAddTabButtonVisible="False">
      <TabViewItem Header="Setup URI" IsClosable="False">
        <StackPanel Padding="8,18,8,8" Spacing="10">
          <TextBlock
              Text="Paste the complete otpauth://totp setup URI. It is validated locally and is never logged."
              TextWrapping="Wrap" />
          <TextBox
              x:Name="UriBox"
              AutomationProperties.Name="TOTP setup URI"
              Header="Setup URI"
              PlaceholderText="otpauth://totp/…"
              TextWrapping="Wrap" />
        </StackPanel>
      </TabViewItem>

      <TabViewItem Header="QR image" IsClosable="False">
        <StackPanel Padding="8,18,8,8" Spacing="12">
          <TextBlock
              Text="Choose a PNG or JPEG containing one authenticator QR code. Decoding happens entirely on this PC."
              TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Click="ChooseImage_Click" Content="Choose image…" />
            <Button Click="PasteImage_Click" Content="Paste clipboard image" />
          </StackPanel>
        </StackPanel>
      </TabViewItem>

      <TabViewItem Header="Manual" IsClosable="False">
        <ScrollViewer Padding="8,14,8,8">
          <StackPanel Spacing="10">
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBox x:Name="IssuerBox" AutomationProperties.Name="Issuer" Header="Issuer" />
              <TextBox
                  x:Name="AccountNameBox"
                  Grid.Column="1"
                  AutomationProperties.Name="Account name"
                  Header="Account name" />
            </Grid>
            <PasswordBox
                x:Name="SecretBox"
                AutomationProperties.Name="Base32 secret"
                Header="Base32 secret"
                PasswordChar="●"
                PlaceholderText="Spaces and lowercase letters are accepted" />
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <ComboBox
                  x:Name="AlgorithmBox"
                  Header="Algorithm"
                  SelectedIndex="0">
                <ComboBoxItem Content="SHA-1" />
                <ComboBoxItem Content="SHA-256" />
                <ComboBoxItem Content="SHA-512" />
              </ComboBox>
              <ComboBox
                  x:Name="DigitsBox"
                  Grid.Column="1"
                  Header="Digits"
                  SelectedIndex="0">
                <ComboBoxItem Content="6" />
                <ComboBoxItem Content="8" />
              </ComboBox>
              <NumberBox
                  x:Name="PeriodBox"
                  Grid.Column="2"
                  Header="Period (seconds)"
                  Maximum="300"
                  Minimum="15"
                  SmallChange="1"
                  Value="30" />
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabViewItem>
    </TabView>
    <InfoBar
        x:Name="ValidationStatus"
        Grid.Row="1"
        Margin="8,10,8,0"
        IsClosable="True"
        IsOpen="False"
        Severity="Informational" />
  </Grid>
</ContentDialog>
