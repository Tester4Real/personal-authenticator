<Window
    x:Class="PersonalAuthenticator.App.Dialogs.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Settings"
    Closed="Window_Closed">

  <Grid
      x:Name="SettingsRoot"
      MinWidth="500"
      MinHeight="420"
      SizeChanged="SettingsRoot_SizeChanged">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <NavigationView
        x:Name="SettingsNavigation"
        Grid.Row="0"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        OpenPaneLength="220"
        PaneDisplayMode="Auto"
        SelectionChanged="SettingsNavigation_SelectionChanged">
      <NavigationView.MenuItems>
        <NavigationViewItem Content="General &amp; security" Tag="GeneralPage" />
        <NavigationViewItem Content="Backup &amp; recovery" Tag="BackupRecoveryPage" />
        <NavigationViewItem Content="Sync" Tag="SyncPage" />
        <NavigationViewItem Content="Devices &amp; advanced" Tag="DevicesPage" />
        <NavigationViewItem Content="About" Tag="AboutPage" />
      </NavigationView.MenuItems>
      <Grid x:Name="SettingsPages" MinWidth="0">
      <Grid x:Name="GeneralPage">
        <ScrollViewer Padding="16" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="14">
            <TextBlock FontSize="20" FontWeight="SemiBold" Text="General" />
            <ComboBox x:Name="ThemeBox" Header="App theme">
              <ComboBoxItem Content="Use Windows setting" />
              <ComboBoxItem Content="Light" />
              <ComboBoxItem Content="Dark" />
            </ComboBox>
            <NumberBox
                x:Name="AutoLockBox"
                Header="Lock after inactivity (minutes, 0 disables)"
                Maximum="1440"
                Minimum="0"
                SmallChange="1" />
            <ToggleSwitch x:Name="LockMinimisedToggle" Header="Lock when minimised" />
            <ToggleSwitch x:Name="LockWindowsToggle" Header="Lock when Windows locks or suspends" />
            <ToggleSwitch x:Name="HideCodesToggle" Header="Hide codes until revealed" />
            <ToggleSwitch x:Name="StartUnlockedToggle" Header="Try to unlock on launch" />
            <Expander Header="Security &amp; clipboard" IsExpanded="False">
              <StackPanel Margin="0,8,0,0" Spacing="14">
                <NumberBox
                    x:Name="ClipboardDelayBox"
                    Header="Clear copied codes after (seconds)"
                    Maximum="300"
                    Minimum="5"
                    SmallChange="5" />
                <ToggleSwitch
                    x:Name="VerificationToggle"
                    Header="Verify with Windows before revealing or copying codes" />
                <InfoBar
                    HorizontalContentAlignment="Stretch"
                    IsClosable="False"
                    IsOpen="True"
                    Severity="Informational">
                  <TextBlock Text="Windows verification confirms that you are present. Windows account protection continues to encrypt the vault." TextWrapping="Wrap" />
                </InfoBar>
                <TextBlock
                    Text="Clipboard clearing reduces exposure time, but other software can still read a code while it is copied."
                    TextWrapping="Wrap" />
              </StackPanel>
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <Grid x:Name="BackupRecoveryPage" Visibility="Collapsed">
        <ScrollViewer Padding="16" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="12">
            <TextBlock FontSize="20" FontWeight="SemiBold" Text="Vault status" />
            <TextBlock
                x:Name="VaultModeText"
                TextWrapping="Wrap" />
            <InfoBar
                HorizontalContentAlignment="Stretch"
                IsClosable="False"
                IsOpen="True"
                Severity="Informational">
              <TextBlock Text="A v2 upgrade creates and verifies a separate encrypted vault. The original vault.pav remains unchanged, and rollback remains available." TextWrapping="Wrap" />
            </InfoBar>
            <Button
                x:Name="UpgradeVaultButton"
                Click="UpgradeVaultButton_Click"
                Content="Upgrade to v2…"
                HorizontalAlignment="Left" />
            <Expander Header="Encrypted backup" IsExpanded="False">
              <StackPanel Margin="0,8,0,0" Spacing="12">
                <InfoBar
                    HorizontalContentAlignment="Stretch"
                    IsClosable="False"
                    IsOpen="True"
                    Severity="Warning">
                  <TextBlock Text="If you lose both this password and your service recovery codes, your accounts may be unrecoverable." TextWrapping="Wrap" />
                </InfoBar>
                <PasswordBox
                    x:Name="BackupPasswordBox"
                    Header="Backup password (12+ characters)"
                    PasswordChar="●" />
                <PasswordBox
                    x:Name="ConfirmPasswordBox"
                    Header="Confirm backup password"
                    PasswordChar="●" />
                <StackPanel Spacing="8" HorizontalAlignment="Left">
                  <Button Click="ExportButton_Click" Content="Export encrypted backup…" />
                  <Button Click="ImportButton_Click" Content="Import encrypted backup…" />
                </StackPanel>
                <Expander Header="Advanced restore options" IsExpanded="False">
                  <ComboBox
                      x:Name="ImportModeBox"
                      Margin="0,8,0,0"
                      Header="Restore behaviour"
                      SelectedIndex="0">
                    <ComboBoxItem Content="Merge and skip duplicates" />
                    <ComboBoxItem Content="Merge and replace matching accounts" />
                    <ComboBoxItem Content="Merge and keep duplicates" />
                    <ComboBoxItem Content="Replace current vault exactly" />
                  </ComboBox>
                </Expander>
              </StackPanel>
            </Expander>
            <Expander Header="Recovery A/B" IsExpanded="False">
              <StackPanel Margin="0,8,0,0" Spacing="12">
                <InfoBar
                    HorizontalContentAlignment="Stretch"
                    IsClosable="False"
                    IsOpen="True"
                    Severity="Informational">
                  <TextBlock Text="Recovery uses two alternating encrypted files. A new file is fully verified before it becomes the latest recovery." TextWrapping="Wrap" />
                </InfoBar>
                <InfoBar
                    HorizontalContentAlignment="Stretch"
                    IsClosable="False"
                    IsOpen="True"
                    Severity="Warning">
                  <TextBlock Text="Restoring verifies a new local vault before activation. Existing vault files are never deleted automatically." TextWrapping="Wrap" />
                </InfoBar>
                <PasswordBox
                    x:Name="RecoveryPasswordBox"
                    Header="Recovery password (12+ characters)"
                    PasswordChar="●" />
                <PasswordBox
                    x:Name="ConfirmRecoveryPasswordBox"
                    Header="Confirm recovery password"
                    PasswordChar="●" />
                <StackPanel Spacing="8" HorizontalAlignment="Left">
                  <Button Click="CreateRecoveryButton_Click" Content="Create recovery…" />
                  <Button Click="VerifyRecoveryButton_Click" Content="Verify recovery…" />
                  <Button Click="RestoreRecoveryButton_Click" Content="Restore recovery…" />
                </StackPanel>
                <Button
                    Click="RefreshRecoveryHealthButton_Click"
                    Content="Check recovery health"
                    HorizontalAlignment="Left" />
                <TextBlock
                    x:Name="RecoveryHealthText"
                    Text="Recovery health has not been checked."
                    TextWrapping="Wrap" />
              </StackPanel>
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <Grid x:Name="SyncPage" Visibility="Collapsed">
        <ScrollViewer Padding="16" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="12">
            <TextBlock FontSize="20" FontWeight="SemiBold" Text="Sync" />
            <TextBlock
                Text="Sync is optional. GitHub is the normal choice for multiple Windows installations; local-folder sync is available for advanced testing."
                TextWrapping="Wrap" />
            <Expander Header="GitHub sync" IsExpanded="False">
              <StackPanel Margin="0,8,0,0" Spacing="12">
                <InfoBar
                    HorizontalContentAlignment="Stretch"
                    IsClosable="False"
                    IsOpen="True"
                    Severity="Informational">
                  <TextBlock Text="This personal build syncs only with the private Tester4Real/authenticator-sync repository. Repository details are already configured." TextWrapping="Wrap" />
                </InfoBar>
                <TextBlock
                    x:Name="GitHubStatusText"
                    Text="GitHub sync status has not been checked."
                    TextWrapping="Wrap" />
                <StackPanel x:Name="GitHubSetupPanel" Spacing="12">
                  <PasswordBox
                      x:Name="GitHubTokenBox"
                      Header="Repository access token"
                      PasswordChar="●" />
                  <PasswordBox
                      x:Name="GitHubSyncPasswordBox"
                      Header="Sync encryption password (4–12 characters; numbers allowed)"
                      MaxLength="12"
                      PasswordChar="●" />
                  <TextBlock
                      Text="Four digits are accepted, but a longer password protects your encrypted sync data better."
                      TextWrapping="Wrap" />
                  <ToggleSwitch
                      x:Name="GitHubBackgroundToggle"
                      Header="Sync automatically every 15 minutes" />
                  <Button
                      Click="ConfigureGitHubButton_Click"
                      Content="Connect GitHub"
                      HorizontalAlignment="Left" />
                </StackPanel>
                <Button
                    x:Name="GitHubSyncButton"
                    Click="SyncGitHubButton_Click"
                    Content="Sync now"
                    HorizontalAlignment="Left"
                    IsEnabled="False" />
                <Expander Header="Maintenance" IsExpanded="False">
                  <StackPanel Margin="0,8,0,0" Spacing="12">
                    <Button
                        Click="TestGitHubButton_Click"
                        Content="Test connection"
                        HorizontalAlignment="Left" />
                    <Button
                        Click="RepairGitHubButton_Click"
                        Content="Repair remote data"
                        HorizontalAlignment="Left" />
                    <Button
                        Click="ForgetGitHubButton_Click"
                        Content="Disable sync and forget credentials"
                        HorizontalAlignment="Left" />
                    <InfoBar
                        HorizontalContentAlignment="Stretch"
                        IsClosable="False"
                        IsOpen="True"
                        Severity="Warning">
                      <TextBlock Text="GitHub failures never delete local accounts. Disabling sync removes the stored Windows credential but does not delete the repository." TextWrapping="Wrap" />
                    </InfoBar>
                  </StackPanel>
                </Expander>
              </StackPanel>
            </Expander>
            <Expander Header="Local-folder sync (advanced)" IsExpanded="False">
              <StackPanel Margin="0,8,0,0" Spacing="12">
                <InfoBar
                    HorizontalContentAlignment="Stretch"
                    IsClosable="False"
                    IsOpen="True"
                    Severity="Informational">
                  <TextBlock Text="Local-folder sync is encrypted and works offline. It is mainly intended for testing or a folder already shared between Windows installations." TextWrapping="Wrap" />
                </InfoBar>
                <TextBox
                    x:Name="SyncFolderBox"
                    Header="Shared folder"
                    IsReadOnly="True"
                    PlaceholderText="Choose a folder…" />
                <Button
                    Click="ChooseSyncFolderButton_Click"
                    Content="Choose folder…"
                    HorizontalAlignment="Left" />
                <PasswordBox
                    x:Name="SyncPasswordBox"
                    Header="Sync password (12+ characters)"
                    PasswordChar="●" />
                <StackPanel Spacing="8" HorizontalAlignment="Left">
                  <Button Click="ConfigureSyncButton_Click" Content="Configure local sync" />
                  <Button Click="SyncNowButton_Click" Content="Sync now" />
                  <Button Click="RefreshSyncButton_Click" Content="Refresh status" />
                </StackPanel>
                <TextBlock
                    x:Name="SyncStatusText"
                    Text="Sync status has not been checked."
                    TextWrapping="Wrap" />
                <Expander Header="Conflict resolution" IsExpanded="False">
                  <StackPanel Margin="0,8,0,0" Spacing="12">
                    <ComboBox
                        x:Name="ConflictBox"
                        DisplayMemberPath="Description"
                        Header="Conflict"
                        HorizontalAlignment="Stretch" />
                    <ComboBox
                        x:Name="ConflictResolutionBox"
                        Header="Resolution"
                        SelectedIndex="0">
                      <ComboBoxItem Content="Keep version A" />
                      <ComboBoxItem Content="Keep version B" />
                      <ComboBoxItem Content="Keep both" />
                      <ComboBoxItem Content="Separate accounts" />
                    </ComboBox>
                    <Button
                        Click="ResolveConflictButton_Click"
                        Content="Resolve selected conflict"
                        HorizontalAlignment="Left" />
                    <TextBlock
                        Text="Secret conflicts preserve every encrypted secret version until you explicitly resolve them."
                        TextWrapping="Wrap" />
                  </StackPanel>
                </Expander>
              </StackPanel>
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <Grid x:Name="DevicesPage" Visibility="Collapsed">
        <ScrollViewer Padding="16" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="12">
            <TextBlock FontSize="20" FontWeight="SemiBold" Text="Authorised devices" />
            <InfoBar
                HorizontalContentAlignment="Stretch"
                IsClosable="False"
                IsOpen="True"
                Severity="Warning">
              <TextBlock Text="Revocation rejects future operations from that device. It cannot erase secrets already copied to the device. Also revoke that device's fine-grained token in GitHub settings." TextWrapping="Wrap" />
            </InfoBar>
            <ListView
                x:Name="DevicesList"
                DisplayMemberPath="DisplayName"
                Header="Authorised Windows devices"
                MaxHeight="180"
                MinHeight="0"
                Visibility="Collapsed" />
            <TextBlock
                x:Name="DevicesEmptyText"
                Text="No authorised devices found."
                TextWrapping="Wrap" />
            <TextBox x:Name="DeviceNameBox" Header="Rename selected device" MaxLength="80" />
            <StackPanel Spacing="8" HorizontalAlignment="Left">
              <Button Click="RenameDeviceButton_Click" Content="Rename selected" />
              <Button Click="RevokeDeviceButton_Click" Content="Revoke selected" />
              <Button Click="RefreshDevicesButton_Click" Content="Refresh" />
            </StackPanel>
            <TextBlock x:Name="DeviceDetailsText" TextWrapping="Wrap" />
            <Expander Header="Key rotation (advanced)" IsExpanded="False">
              <StackPanel Margin="0,8,0,0" Spacing="12">
                <TextBox x:Name="SecurityRecoveryDirectoryBox" Header="Recovery folder" />
                <PasswordBox
                    x:Name="SecurityRecoveryPasswordBox"
                    Header="Recovery password"
                    PasswordChar="●" />
                <Button
                    Click="RotateKeysButton_Click"
                    Content="Rotate encryption keys…"
                    HorizontalAlignment="Left" />
                <InfoBar
                    HorizontalContentAlignment="Stretch"
                    IsClosable="False"
                    IsOpen="True"
                    Severity="Informational">
                  <TextBlock Text="Key rotation creates and verifies replacement vault and recovery files before activation. Existing encrypted files remain available for rollback." TextWrapping="Wrap" />
                </InfoBar>
                <TextBlock x:Name="SecurityEpochText" TextWrapping="Wrap" />
              </StackPanel>
            </Expander>
            <Expander Header="Permanent purge (dangerous)" IsExpanded="False">
              <StackPanel Margin="0,8,0,0" Spacing="12">
                <TextBox x:Name="PurgeAccountIdBox" Header="Archived account ID" />
                <TextBox x:Name="PurgeConfirmationBox" Header="Type PURGE" />
                <Button
                    Click="PurgeAccountButton_Click"
                    Content="Purge archived account…"
                    HorizontalAlignment="Left" />
                <InfoBar
                    HorizontalContentAlignment="Stretch"
                    IsClosable="False"
                    IsOpen="True"
                    Severity="Warning">
                  <TextBlock Text="Old devices, Git history, recovery files and external backups may retain encrypted copies. Physical erasure is not guaranteed. Reset the website's 2FA secret too." TextWrapping="Wrap" />
                </InfoBar>
              </StackPanel>
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <Grid x:Name="AboutPage" Visibility="Collapsed">
        <ScrollViewer Padding="16" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="10">
            <TextBlock FontSize="24" FontWeight="SemiBold" Text="Personal Authenticator" />
            <TextBlock Text="Version 2.0 preview · Local-first TOTP for Windows" />
            <TextBlock
                Text="No analytics, telemetry, advertisements, or required network access. GitHub sync remains optional and disabled until configured."
                TextWrapping="Wrap" />
            <TextBlock FontWeight="SemiBold" Text="Third-party components" />
            <TextBlock
                Text="Windows App SDK and WebView2 (Microsoft Software License Terms) · .NET and Microsoft.Extensions (MIT) · CommunityToolkit.Mvvm (MIT) · Otp.NET (MIT) · Konscious.Security.Cryptography.Argon2 (MIT) · ZXing.Net (Apache-2.0)"
                TextWrapping="Wrap" />
            <TextBlock
                Text="Dependency and licence details are in THIRD-PARTY-NOTICES.md beside the application executable."
                TextWrapping="Wrap" />
            <TextBlock
                Text="Running an authenticator on the same PC used to sign in reduces separation between factors. Malware running as your Windows user can access decrypted data and clipboard contents."
                TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </Grid>
      </Grid>
    </NavigationView>
    <InfoBar
        x:Name="SettingsStatus"
        Grid.Row="1"
        Margin="12,8,12,0"
        HorizontalContentAlignment="Stretch"
        IsClosable="True"
        IsOpen="False">
      <TextBlock x:Name="SettingsStatusText" TextWrapping="Wrap" />
    </InfoBar>
    <Grid
        Grid.Row="2"
        Padding="12"
        ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button
          Grid.Column="1"
          AccessKey="C"
          Click="CloseSettingsButton_Click"
          Content="Close" />
      <Button
          Grid.Column="2"
          AccessKey="S"
          Click="SaveSettingsButton_Click"
          Content="Save settings" />
    </Grid>
  </Grid>
</Window>
